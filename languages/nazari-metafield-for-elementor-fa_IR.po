msgstr "فیلدها"

msgid "Post types covered"
msgstr "انواع نوشتهٔ پوشش‌داده‌شده"

msgid "Active"
msgstr "فعال"

msgid "Missing"
msgstr "نصب نیست"

msgid "Elementor"
msgstr "المنتور"

msgid "Your field groups"
msgstr "گروه‌های فیلد شما"

